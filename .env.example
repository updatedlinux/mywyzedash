# Carpeta que ya genera docker-wyze-bridge. Solo lectura.
RECORDINGS_PATH=/Volumes/WyzeNVR/wyze-bridge/recordings

# IP del Mac mini donde corre el bridge. El navegador abre el m3u8 ahí, sin proxy.
BRIDGE_HOST=192.168.88.37

# El 5080 es el WebUI. El HLS que muestra el bridge es el puerto 8888.
HLS_PORT=8888
RTSP_PORT=8554

# Master playlist absoluto: http://192.168.88.37:8888/hls/{camera}.m3u8
HLS_PATH=/hls/{camera}.m3u8

# Puerto de esta app. No debe coincidir con el del bridge.
PORT=3000
