# Carpeta que ya genera docker-wyze-bridge. Solo lectura.
RECORDINGS_PATH=/Volumes/WyzeNVR/wyze-bridge/recordings

# IP del Mac mini donde corre el bridge. Vacío = el navegador usa el mismo host que esta app.
BRIDGE_HOST=192.168.88.25

# Puertos del bridge. No los usa esta app para RTSP; HLS se abre directo desde el navegador.
HLS_PORT=8888
RTSP_PORT=8554

# Plantilla del manifiesto HLS de go2rtc. {camera} se sustituye por el nombre de la carpeta.
HLS_PATH=/{camera}/index.m3u8

# Puerto de esta app. No debe coincidir con 5080, 8554 ni 8888.
PORT=3000
